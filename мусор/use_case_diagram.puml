@startuml SportBook_UseCases
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor White
    BorderColor #333333
    ArrowColor #333333
    ActorBackgroundColor White
    ActorBorderColor #333333
}
skinparam linetype ortho
left to right direction

title Диаграмма вариантов использования — SportBook

' ─── Акторы ───────────────────────────────────────────────
actor "Арендатор"    as Renter
actor "Арендодатель" as Landlord
actor "Администратор" as Admin

' ─── Граница системы ──────────────────────────────────────
rectangle "Система SportBook" {

    ' == Общие варианты ==
    usecase "Зарегистрироваться"      as UC_Register
    usecase "Войти в систему"         as UC_Login
    usecase "Ввести логин"            as UC_Email
    usecase "Ввести пароль"           as UC_Password
    usecase "Выйти из системы"        as UC_Logout
    usecase "Просмотреть профиль"     as UC_Profile

    ' == Арендатор ==
    usecase "Просматривать каталог\nплощадок"       as UC_Catalog
    usecase "Фильтровать площадки"                  as UC_Filter
    usecase "Просматривать\nплощадку"               as UC_ViewVenue
    usecase "Забронировать площадку"                as UC_Book
    usecase "Выбрать дату и время"                  as UC_DateTime
    usecase "Просматривать свои\nбронирования"      as UC_MyBookings
    usecase "Отменить бронирование"                 as UC_CancelBook
    usecase "Добавить в избранное"                  as UC_Fav
    usecase "Оставить отзыв"                        as UC_Review

    ' == Арендодатель ==
    usecase "Пройти верификацию"                    as UC_Verify
    usecase "Загрузить документы"                   as UC_Docs
    usecase "Добавить площадку"                     as UC_AddVenue
    usecase "Редактировать площадку"                as UC_EditVenue
    usecase "Удалить площадку"                      as UC_DelVenue
    usecase "Просматривать бронирования\nсвоих площадок" as UC_LandBookings
    usecase "Подтвердить бронирование"              as UC_ConfirmBook
    usecase "Отклонить бронирование"                as UC_RejectBook

    ' == Администратор ==
    usecase "Просматривать заявки\nна верификацию"  as UC_VerifyList
    usecase "Одобрить верификацию"                  as UC_ApproveV
    usecase "Отклонить верификацию"                 as UC_RejectV
    usecase "Управлять пользователями"              as UC_ManageUsers
    usecase "Просматривать все\nплощадки"           as UC_AllVenues

}

' ─── Связи: Общие ─────────────────────────────────────────
Renter    --> UC_Register
Renter    --> UC_Login
Landlord  --> UC_Register
Landlord  --> UC_Login
Admin     --> UC_Login
Renter    --> UC_Logout
Landlord  --> UC_Logout
Admin     --> UC_Logout
Renter    --> UC_Profile
Landlord  --> UC_Profile

UC_Login     ..> UC_Email    : <<include>>
UC_Login     ..> UC_Password : <<include>>
UC_Register  ..> UC_Email    : <<include>>
UC_Register  ..> UC_Password : <<include>>

' ─── Связи: Арендатор ─────────────────────────────────────
Renter --> UC_Catalog
Renter --> UC_ViewVenue
Renter --> UC_Book
Renter --> UC_MyBookings
Renter --> UC_CancelBook
Renter --> UC_Fav
Renter --> UC_Review

UC_Catalog ..> UC_Filter  : <<extend>>
UC_Book    ..> UC_DateTime : <<include>>

' ─── Связи: Арендодатель ──────────────────────────────────
Landlord --> UC_Verify
Landlord --> UC_AddVenue
Landlord --> UC_EditVenue
Landlord --> UC_DelVenue
Landlord --> UC_LandBookings
Landlord --> UC_ConfirmBook
Landlord --> UC_RejectBook

UC_Verify   ..> UC_Docs    : <<include>>
UC_AddVenue ..> UC_Verify  : <<include>>

' ─── Связи: Администратор ─────────────────────────────────
Admin --> UC_VerifyList
Admin --> UC_ApproveV
Admin --> UC_RejectV
Admin --> UC_ManageUsers
Admin --> UC_AllVenues

UC_VerifyList ..> UC_ApproveV : <<extend>>
UC_VerifyList ..> UC_RejectV  : <<extend>>

@enduml
